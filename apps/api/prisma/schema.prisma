// Pomodoro data model.
//
// Two conventions run through this schema and are deliberate:
//
// 1. `userId` is denormalised onto Task and PomodoroSession even though it is
//    reachable through Project. Every read is scoped to its owner, so
//    authorisation becomes a systematic `where: { userId }` with no join, and a
//    missing scope is visible in review rather than hidden behind a relation.
//
// 2. A session stores *when it began* and *how long it should last*, never a
//    mutable "time remaining". Everything else is derived. That is what makes
//    closing the app, restarting the backend or opening another device correct
//    by construction instead of by synchronisation.
//
// Invariants that SQL can express live in the database, not only in services.
// See `migrations/*_add_domain_constraints`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum SessionKind {
  FOCUS
  SHORT_BREAK
  LONG_BREAK
}

/// Why a refresh token stopped being valid.
///
/// Reuse detection must only be armed for tokens retired by rotation. A token
/// retired by an explicit logout being presented again is a client retrying,
/// not evidence of theft, and must not end the user's other sessions.
enum RefreshTokenRevokedReason {
  ROTATED
  LOGOUT
  REUSE_DETECTED
}

enum SessionStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

model User {
  id           String @id @default(uuid(7)) @db.Uuid
  email        String @unique
  passwordHash String @map("password_hash")
  name         String @db.VarChar(120)

  /// Defaults applied when a session is started without an explicit duration.
  focusDurationSec     Int @default(1500) @map("focus_duration_sec")
  shortBreakSec        Int @default(300) @map("short_break_sec")
  longBreakSec         Int @default(900) @map("long_break_sec")
  cyclesUntilLongBreak Int @default(4) @map("cycles_until_long_break")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  projects      Project[]
  tasks         Task[]
  sessions      PomodoroSession[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Project {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  name  String @db.VarChar(120)
  /// Hex colour used by the client, e.g. #E5484D.
  color String @default("#6E56CF") @map("color") @db.VarChar(7)

  /// Soft delete: archiving a project must not erase the focus time already
  /// recorded against its tasks.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId, archivedAt])
  @@map("projects")
}

model Task {
  id        String  @id @default(uuid(7)) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  projectId String? @map("project_id") @db.Uuid

  title              String     @db.VarChar(200)
  status             TaskStatus @default(TODO)
  estimatedPomodoros Int        @default(1) @map("estimated_pomodoros")

  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Detaching, not deleting: history outlives the project it belonged to.
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  sessions PomodoroSession[]

  @@index([userId, status])
  @@index([projectId])
  @@map("tasks")
}

model PomodoroSession {
  id     String  @id @default(uuid(7)) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  taskId String? @map("task_id") @db.Uuid

  kind   SessionKind
  status SessionStatus

  startedAt           DateTime  @map("started_at") @db.Timestamptz(3)
  durationSec         Int       @map("duration_sec")
  /// Set only while the session is PAUSED; cleared on resume.
  pausedAt            DateTime? @map("paused_at") @db.Timestamptz(3)
  /// Total time already spent paused, so elapsed time excludes it.
  pausedAccumulatedMs Int       @default(0) @map("paused_accumulated_ms")
  /// Set only once the session reached COMPLETED or CANCELLED.
  endedAt             DateTime? @map("ended_at") @db.Timestamptz(3)

  /// Client-generated idempotency key. A retried start request after a dropped
  /// connection resolves to the same session instead of a duplicate.
  clientMutationId String? @unique @map("client_mutation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, status])
  @@index([taskId])
  @@map("pomodoro_sessions")
}

model RefreshToken {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Only the hash is stored; the opaque token itself never touches the database.
  tokenHash String @unique @map("token_hash")

  expiresAt     DateTime                   @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?                  @map("revoked_at") @db.Timestamptz(3)
  revokedReason RefreshTokenRevokedReason? @map("revoked_reason")
  deviceLabel   String?                    @map("device_label") @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
