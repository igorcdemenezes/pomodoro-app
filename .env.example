# Copy to .env and adjust as needed: cp .env.example .env
#
# These values feed docker-compose and are the defaults the API expects when
# running against the local database.

# --- API ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL container ---
# Published on 5433 rather than the default 5432: a developer machine commonly
# already has something bound to 5432. The container still listens on 5432
# internally, so only the host port differs.
POSTGRES_USER=pomodoro
POSTGRES_PASSWORD=pomodoro
POSTGRES_DB=pomodoro
POSTGRES_PORT=5433
TEST_DATABASE=pomodoro_test

# --- Connection strings used by Prisma ---
DATABASE_URL=postgresql://pomodoro:pomodoro@localhost:5433/pomodoro?schema=public
TEST_DATABASE_URL=postgresql://pomodoro:pomodoro@localhost:5433/pomodoro_test?schema=public
