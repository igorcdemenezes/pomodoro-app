# Copy to .env and adjust as needed: cp .env.example .env
#
# These values feed docker-compose and are the defaults the API expects when
# running against the local database.

# --- API ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL container ---
POSTGRES_USER=pomodoro
POSTGRES_PASSWORD=pomodoro
POSTGRES_DB=pomodoro
POSTGRES_PORT=5432
TEST_DATABASE=pomodoro_test

# --- Connection strings used by Prisma ---
DATABASE_URL=postgresql://pomodoro:pomodoro@localhost:5432/pomodoro?schema=public
TEST_DATABASE_URL=postgresql://pomodoro:pomodoro@localhost:5432/pomodoro_test?schema=public
