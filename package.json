{
  "name": "pomodoro-app",
  "version": "0.1.0",
  "private": true,
  "description": "Pomodoro productivity app: React Native client backed by a NestJS API and PostgreSQL",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "api": "npm run --workspace @pomodoro/api",
    "mobile": "npm run --workspace @pomodoro/mobile",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U ${POSTGRES_USER:-pomodoro} -d ${POSTGRES_DB:-pomodoro}",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{json,md,yml,yaml}": "prettier --write",
    "*.{js,jsx,ts,tsx}": "prettier --write"
  }
}
